[
  {
    "name": "web_search",
    "description": "Search the web and return bounded, source-linked results or provider answers. Full results are stored for retrieval with get_search_content using the returned responseId.",
    "schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Single search query.",
          "maxLength": 4096
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "description": "Multiple queries searched concurrently; vary angles for broader coverage.",
          "maxItems": 20
        },
        "numResults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Results per query (default: 5, max: 20)."
        },
        "includeContent": {
          "type": "boolean",
          "description": "Also fetch full page content for the results, retrievable with get_search_content."
        },
        "recencyFilter": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month",
            "year"
          ],
          "description": "Filter results by recency."
        },
        "domainFilter": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Limit to domains; prefix with - to exclude.",
          "maxItems": 20
        },
        "category": {
          "type": "string",
          "description": "Exa only: result category, e.g. news, research paper."
        },
        "provider": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "auto",
                "all",
                "openai",
                "brave",
                "parallel",
                "parallel-mcp",
                "tinyfish",
                "search1api",
                "searchinfinity",
                "querit",
                "tavily",
                "you",
                "firecrawl",
                "jina",
                "searxng",
                "degoog",
                "duckduckgo",
                "perplexity",
                "gemini",
                "exa",
                "serpdive",
                "kagi",
                "ollama",
                "anysearch",
                "xai",
                "mistral",
                "brightdata",
                "serpbase",
                "serpapi",
                "serper",
                "serply",
                "valyu",
                "bocha",
                "xcrawl",
                "baizhi",
                "zai",
                "keenable",
                "ceramic",
                "kimi"
              ],
              "description": "Single provider."
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "openai",
                  "brave",
                  "parallel",
                  "parallel-mcp",
                  "tinyfish",
                  "search1api",
                  "searchinfinity",
                  "querit",
                  "tavily",
                  "you",
                  "firecrawl",
                  "jina",
                  "searxng",
                  "degoog",
                  "duckduckgo",
                  "perplexity",
                  "gemini",
                  "exa",
                  "serpdive",
                  "kagi",
                  "ollama",
                  "anysearch",
                  "xai",
                  "mistral",
                  "brightdata",
                  "serpbase",
                  "serpapi",
                  "serper",
                  "serply",
                  "valyu",
                  "bocha",
                  "xcrawl",
                  "baizhi",
                  "zai",
                  "keenable",
                  "ceramic",
                  "kimi"
                ],
                "description": "Provider."
              },
              "minItems": 1
            }
          ],
          "description": "Search provider, or a non-empty list of providers to search simultaneously. Omit or use auto for the configured provider; all searches every eligible provider. Providers without credentials return an error."
        },
        "proxy": {
          "type": "string",
          "description": "http(s) or socks proxy URL for this call's outbound requests; empty string forces direct access."
        },
        "workflow": {
          "type": "string",
          "enum": [
            "none",
            "auto-summary",
            "summary-review"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "fetch_content",
    "description": "Fetch URL(s) and return bounded content. Supports web pages, GitHub repositories, and PDFs. Full content is stored for retrieval with get_search_content using the returned responseId.",
    "schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Single URL to fetch.",
          "maxLength": 4096
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "description": "Multiple URLs fetched in parallel.",
          "maxItems": 20
        },
        "mode": {
          "type": "string",
          "enum": [
            "readable",
            "raw",
            "answer"
          ],
          "description": "readable = extract readable content as markdown (default); raw = return the exact textual body using direct HTTP only."
        },
        "forceClone": {
          "type": "boolean",
          "description": "Force cloning GitHub repositories that exceed the size threshold."
        },
        "proxy": {
          "type": "string",
          "description": "http(s) or socks proxy URL for this call's outbound requests; empty string forces direct access."
        },
        "prompt": {
          "type": "string",
          "maxLength": 8192
        },
        "answerModel": {
          "type": "string",
          "maxLength": 512
        },
        "auth": {
          "type": "string",
          "maxLength": 128
        },
        "timestamp": {
          "type": "string",
          "maxLength": 128
        },
        "frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "artifactRef": {
          "type": "string",
          "maxLength": 256,
          "description": "Authorized video Artifact to analyze. Use instead of url/urls; arbitrary host file paths are forbidden."
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "get_search_content",
    "description": "Retrieve bounded pages of stored search results or fetched content from a previous web_search, fetch_content, or source_check call, or find matching passages with findText.",
    "schema": {
      "type": "object",
      "required": [
        "responseId"
      ],
      "properties": {
        "responseId": {
          "type": "string",
          "description": "The responseId from web_search, fetch_content, or source_check."
        },
        "query": {
          "type": "string",
          "description": "Select stored results for this search query.",
          "maxLength": 4096
        },
        "queryIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "Select stored results for the query at this index."
        },
        "url": {
          "type": "string",
          "description": "Select stored content for this URL.",
          "maxLength": 4096
        },
        "urlIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "Select stored content for the URL at this index."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Character offset into the stored content (default 0). Ignored when findText is supplied."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum characters to return. Ignored when findText is supplied.",
          "maximum": 32000
        },
        "findText": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "minItems": 1,
              "maxItems": 10
            }
          ],
          "description": "Text or texts to find in the selected stored content."
        },
        "findMode": {
          "type": "string",
          "enum": [
            "exact",
            "case-insensitive",
            "fuzzy"
          ],
          "description": "Matching mode for findText (default: case-insensitive)."
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "source_check",
    "description": "Gather web sources for a claim and return a bounded machine-readable research artifact with exact passage citations for manual review.",
    "schema": {
