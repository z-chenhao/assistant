    {
      "old": {
        "source": "docs/technical-design.md",
        "section": "3.9",
        "line": 237,
        "sha256": "89061d36e17d5d81eeb4b93fb5890794fb110bcf54568b6c1d4c622bbbdd55bb",
        "area": "tasks",
        "text": "```typescript\ntype ArtifactRef = string;\ntype TaskRef = string;\ntype TaskStatus = \"active\" | \"paused\" | \"completed\" | \"cancelled\";\n\ninterface TaskSearchRequest {\n  query?: string;\n  scope?: \"active\" | \"recent\" | \"all\";\n  status?: readonly TaskStatus[];\n  limit?: number;\n}\n\ninterface TaskSummary {\n  taskRef: TaskRef;\n  title: string;\n  goalSummary: string;\n  status: TaskStatus;\n  progressSummary?: string;\n  updatedAt: string;\n}\n\ntype TaskManageOperation = \"create\" | \"append\" | \"pause\" | \"cancel\";\n\ninterface TaskCreateRequest {\n  operation: \"create\";\n  task: string;\n  artifactRefs?: readonly ArtifactRef[];\n}\n\ninterface TaskAppendRequest {\n  operation: \"append\";\n  taskRef: TaskRef;\n  instruction: string;\n  artifactRefs?: readonly ArtifactRef[];\n}\n\ninterface TaskPauseRequest {\n  operation: \"pause\";\n  taskRef: TaskRef;\n}\n\ninterface TaskCancelRequest {\n  operation: \"cancel\";\n  taskRef: TaskRef;\n}\n\ntype TaskManageRequest =\n  | TaskCreateRequest\n  | TaskAppendRequest\n  | TaskPauseRequest\n  | TaskCancelRequest;\n\ninterface TaskManageReceipt {\n  taskRef: TaskRef;\n  status: TaskStatus;\n  accepted: true;\n}\n```"
      },
      "proposed_new": {
        "source": "docs/technical-design.md",
        "section": "3.9",
        "line": 240,
        "text": "```typescript\ntype ArtifactRef = string;\ntype TaskRef = string;\ntype TaskStatus = \"active\" | \"paused\" | \"completed\" | \"cancelled\";\n\ninterface TaskSearchRequest {\n  query?: string;\n  scope?: \"active\" | \"recent\" | \"all\";\n  status?: readonly TaskStatus[];\n  limit?: number;\n}\n\ninterface TaskSummary {\n  taskRef: TaskRef;\n  title: string;\n  goalSummary: string;\n  status: TaskStatus;\n  progressSummary?: string;\n  updatedAt: string;\n}\n\ntype TaskManageOperation = \"create\" | \"append\" | \"pause\" | \"cancel\" | \"complete\";\n\ninterface TaskCreateRequest {\n  operation: \"create\";\n  task: string;\n  completionPolicy?: \"once\" | \"ongoing\";\n  artifactRefs?: readonly ArtifactRef[];\n}\n\ninterface TaskAppendRequest {\n  operation: \"append\";\n  taskRef: TaskRef;\n  instruction: string;\n  artifactRefs?: readonly ArtifactRef[];\n}\n\ninterface TaskPauseRequest {\n  operation: \"pause\";\n  taskRef: TaskRef;\n}\n\ninterface TaskCancelRequest {\n  operation: \"cancel\";\n  taskRef: TaskRef;\n}\n\ninterface TaskCompleteRequest {\n  operation: \"complete\";\n  taskRef: TaskRef;\n}\n\ntype TaskManageRequest =\n  | TaskCreateRequest\n  | TaskAppendRequest\n  | TaskPauseRequest\n  | TaskCancelRequest\n  | TaskCompleteRequest;\n\ninterface TaskManageReceipt {\n  taskRef: TaskRef;\n  status: TaskStatus;\n  accepted: true;\n}\n```",
        "sha256": "078855ab242f03e91f4165b65175cf4fd552c3d7c24c2a9614adaec33a62d35b"
      },
      "status": "awaiting_coordinator_reseal",
      "approval": "docs/adr/006-explicit-task-completion-policy.md",
      "merged_pr": "https://github.com/z-chenhao/erii/pull/45"
